{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "DistMq": {
    "Storage": "Azure",
    "ConnectionString": "UseDevelopmentStorage=true",
    "Namespace": "default",
    "MaintenanceInterval": "00:00:05"
  }
}
